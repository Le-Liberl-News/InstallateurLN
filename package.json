{
  "name": "setupliberlnews",
  "version": "1.1.1",
  "description": "Installateur de patchs pour l'équipe du Liberl News",
  "main": "index.js",
  "bin": "./index.js",
  "scripts": {
    "test": "test",
    "prestart": "node scripts/fetch-xdelta3.js",
    "start": "electron .",
    "prebuild": "node scripts/fetch-xdelta3.js",
    "build": "electron-builder",
    "release": "electron-builder --publish always"
  },
  "author": "Schneitizel S. Sekai",
  "license": "ISC",
  "devDependencies": {
    "electron": "^38.8.6",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "@electron/remote": "^2.1.3",
    "bluebird": "^3.7.2",
    "electron-updater": "^6.8.9",
    "jquery": "^3.7.1",
    "node-fetch": "^2.6.7",
    "node-stream-zip": "^1.15.0",
    "regedit": "^5.1.3",
    "svg-pan-zoom": "^3.6.1",
    "yauzl": "^2.10.0"
  },
  "build": {
    "appId": "com.liberlnews.installer",
    "productName": "Installateur du Liberl News",
    "directories": {
      "output": "dist"
    },
    "compression": "maximum",
    "publish": [
      {
        "provider": "github",
        "owner": "Le-Liberl-News",
        "repo": "InstallateurLN"
      }
    ],
    "files": [
      "index.js",
      "functions.js",
      "vdf.js",
      "loading.html",
      "jquery.min.js",
      "config.json",
      "projects.json",
      "doc/*",
      "css/*",
      "audio/**/*",
      "images/**/*",
      "index.html",
      "!images/wp.gif",
      "!images/menu_icon.pdn"
    ],
    "extraResources": [
      {
        "from": "bin",
        "to": "bin",
        "filter": [
          "**/*"
        ]
      }
    ],
    "portable": {
      "useZip": true,
      "splashImage": "./images/splash.bmp"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Installateur du Liberl News",
      "artifactName": "Installateur-du-Liberl-News-Setup-${version}.${ext}",
      "deleteAppDataOnUninstall": false
    },
    "win": {
      "icon": "icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  }
}
